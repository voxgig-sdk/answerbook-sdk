# Entity: poetry__oracle

main: kit: entity: poetry__oracle: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      type: "`$STRING`"
    }
    {
      name: "content"
      req: false
      type: "`$STRING`"
    }
    {
      name: "interpretation"
      req: false
      type: "`$STRING`"
    }
    {
      name: "poem"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Fortune type (Great Fortune, etc.)"
      type: "`$STRING`"
    }
  ]

  name: "poetry__oracle"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/TangPoetry"
          parts: [
            "TangPoetry"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.poem`"
          }
        }
        {
          method: "GET"
          orig: "/TempleOracleJP"
          parts: [
            "TempleOracleJP"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.oracle`"
          }
        }
      ]
    }
  }



}
